<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>baseline_mission</name>
  <version>0.0.0</version>
  <description>Boustrophedon baseline mission: exhaustive lawnmower survey dispatched as pose_to_pose action goals</description>
  <maintainer email="talal.alotaibi@utexas.edu">talal</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>geometry_msgs</depend>
  <depend>uuv_interfaces</depend>
  <depend>tf2_ros</depend>
  <depend>tf_transformations</depend>

  <exec_depend>vista_sim</exec_depend>
  <exec_depend>rqt_console</exec_depend>
  <exec_depend>rqt_graph</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
