<root BTCPP_format="4">
    <BehaviorTree ID="NBVOnTarget">
        <Sequence>
            <!-- Build ROI extents Vector3 from hardcoded dimensions -->
            <SetROIExtents x_length="3.0" y_length="3.0" z_length="3.0" roi_extents="{roi_extents}"/>

            <!-- Wrap PoseStamped to SharedPtr for PublishTransform -->
            <MakeShared value_in="{current_pose}" shared_ptr="{current_pose_ptr}"/>

            <!-- Broadcast roi_frame at target position relative to map for visualization and sampling -->
            <PublishTransform parent_frame="map" child_frame="roi_frame" from_pose="{current_pose_ptr}" static="true"/>

            <!-- Initialize NBV solver for this target -->
            <ActivatePolicy roi_center="{current_pose}" roi_extents="{roi_extents}"/>

            <!-- Helix-manifold sampler (ACTIVE). To run the cone instead: comment
                 out this block and uncomment the SampleViewPosesCone block below.
                 Both write to {poses}, so nothing downstream changes. -->
            <SampleViewPosesHelix
                clearance_height="15"
                helix_height="15"
                min_radius="10.0"
                radius_multiplier="4"
                num_shells="4"
                delta_theta="24"
                psi_max_deg="15"
                mount_angle_deg="20"
                view_poses="{poses}"
            />

            <!-- Cone-manifold sampler (currently disabled). r = z/tan(mount_angle);
                 rings span [clearance, cone_height]; pitch is handled by the path
                 planner, not the sampler. -->
            <!--
            <SampleViewPosesCone
                num_rings="3"
                clearance="15"
                cone_height="30"
                delta_theta="36"
                mount_angle_deg="20"
                view_poses="{poses}"
            />
            -->


            <!-- Initial scoring of all candidates (do-while seed) -->
            <SetViews sensor_name="fls" view_poses="{poses}" fractional_scores="{scores}"/>

            <!-- NBV loop: repeat while not saturated -->
            <RepeatWhile reactive = "false">
                <Inverter>
                    <CheckScoreSaturation threshold="0.05" patience="3" fractional_scores="{scores}"/>
                </Inverter>
                <Sequence>
                    <!-- Cost each remaining candidate via true Dubins path length (NED, server-side) -->
                    <PathLengthClient
                        view_poses="{poses}"
                        robot_frame_id="base_link"
                        view_frame_id="sonar_optical"
                        turn_radius="10.0"
                        max_pitch_deg="15"
                        path_costs="{path_costs}"
                    />
                    <!-- Select best viewpoint by info-gain vs path-cost utility, remove from candidate list -->
                    <GetBestViewWithCost
                        view_poses="{poses}"
                        fractional_scores="{scores}"
                        path_costs="{path_costs}"
                        alpha="{alpha}"
                        best_view_pose="{best_view_pose}"
                        new_poses="{poses}"
                        new_scores="{scores}"
                    />
                    <!-- Back-propagate optical-frame pose to base_link pose (still in roi_frame) -->
                    <CalculatePlanningPose
                        view_pose="{best_view_pose}"
                        view_frame="sonar_optical"
                        planning_frame="base_link"
                        planning_pose="{planning_pose}"
                    />
                    <!-- Convert to NED and send Dubins action goal; cancel after timeout, skip if unreachable -->
                    <ForceSuccess>
                        <DubinsClient planning_pose="{planning_pose}" timeout_sec="1200"/>
                    </ForceSuccess>
                    <!-- Re-score remaining candidates with updated TSDF -->
                    <SetViews sensor_name="fls" view_poses="{poses}" fractional_scores="{scores}"/>
                </Sequence>
            </RepeatWhile>

            <!-- Finalize reconstruction for this target, returning BOTH the Marching
                 Cubes mesh and the ROI-clipped surface point cloud. The point cloud has
                 no MC triangulation, so it cannot fragment on sparse returns -- useful as
                 a fallback view when the mesh comes out patchy at long standoff. -->
            <ConcludePolicy return_pointcloud="true" return_mesh="true"
                            scene_mesh="{object_mesh}" roi_cloud="{object_cloud}"/>

            <!-- Save the reconstructed mesh to disk under this run's reconstruction_dir
                 (seeded onto the blackboard by run_bt from the launch parameter, so it
                 matches the bag's run label). Named by target id. SaveModelToFile creates
                 the directory and picks the format from the file extension (.ply/.stl/.obj). -->
            <Script code="mesh_path := reconstruction_dir .. '/target_' .. current_ID .. '.ply'"/>
            <SaveModelToFile file_path="{mesh_path}" mesh="{object_mesh}" overwrite="true"/>

            <!-- Also save the ROI surface point cloud (.pcd), same folder/name as the mesh.
                 No Marching Cubes, so it never fragments; view with `pcl_viewer target_N.pcd`
                 (needs pcl-tools). -->
            <Script code="cloud_path := reconstruction_dir .. '/target_' .. current_ID .. '.pcd'"/>
            <SaveModelToFile file_path="{cloud_path}" points="{object_cloud}" overwrite="true"/>

            <!-- Signal DetectAndSortQueue to retire this target -->
            <MarkTargetComplete current_id_read="{current_ID}" completed_id_write="{completed_id}"/>
        </Sequence>
    </BehaviorTree>
</root>
